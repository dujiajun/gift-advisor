<view class="page">
  <view class="deco cloud-1">☁️</view>
  <view class="deco cloud-2">☁️</view>
  <view class="deco star-1">⭐</view>
  <view class="deco star-2">✨</view>

  <view class="hero">
    <view class="hero-gift">🎁</view>
    <view class="logo">
      <view
        wx:for="{{chars}}"
        wx:key="*this"
        class="logo-chip c{{index % 5}}"
        style="animation-delay: {{index * 0.09}}s"
      >{{item}}</view>
    </view>
    <view class="tagline">🎮 送礼大冒险 · AI 参谋陪你选出好礼</view>
  </view>

  <button class="btn-start" hover-class="pressed" bindtap="start">🎮 我要送礼</button>
  <view class="note">回答 5~10 个问题，参谋献上 3 份好礼</view>
  <view class="footer">AI 生成结果仅供参考 · 最珍贵的是心意 💖</view>
</view>
