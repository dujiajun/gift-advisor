# ===== 环境变量统一放在仓库根目录（cp .env.example .env.local）=====
# 同时服务：Web 版（pnpm dev / start 自动预载）与云函数本地调试（pnpm test:function）。
# 云函数线上环境变量请在 CloudBase 控制台配置，见 docs/cloudbase.md。

# ===== LLM（OpenAI 兼容接口）=====
# 不配置 LLM_API_KEY 时，服务端自动进入"演示模式"：
# 由内置剧本 agent 扮演参谋，无需任何密钥即可跑通全流程。

# --- DeepSeek（默认）---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# --- 推理模型也兼容：响应里的 reasoning_content 会随历史回传给客户端 ---
# LLM_MODEL=deepseek-reasoner

# --- 智谱 GLM ---
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash
# LLM_API_KEY=xxxxxxxx.xxxxxxxxxxxxxxxx

# --- OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# --- Kimi (Moonshot) ---
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# ===== 联网搜索（可选，不配置则参谋只靠模型自身知识）=====
# 到 https://tavily.com 免费注册即可获取 key
TAVILY_API_KEY=
