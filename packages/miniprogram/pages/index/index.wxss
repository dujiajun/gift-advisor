.page {
  min-height: 100vh;
  padding: 0 32rpx 120rpx;
  position: relative;
  overflow: hidden;
  /* 纵向 flex + 最小全屏高：footer 始终吸到页面最底部 */
  display: flex;
  flex-direction: column;
}

/* ---------- 漂浮装饰 ---------- */
.deco {
  position: fixed;
  z-index: 0;
  pointer-events: none;
  opacity: 0.85;
}
.cloud-1 {
  top: 6%;
  left: -60rpx;
  font-size: 128rpx;
  animation: floaty 7s ease-in-out infinite;
}
.cloud-2 {
  top: 16%;
  right: -48rpx;
  font-size: 104rpx;
  animation: floaty 9s ease-in-out 1.2s infinite;
}
.star-1 {
  top: 38%;
  left: 12%;
  font-size: 52rpx;
  animation: twinkle 2.6s ease-in-out infinite;
}
.star-2 {
  top: 30%;
  right: 20%;
  font-size: 44rpx;
  animation: twinkle 3.2s ease-in-out 0.8s infinite;
}

/* ---------- 首页 ---------- */
.hero {
  text-align: center;
  padding: 104rpx 0 40rpx;
  position: relative;
  z-index: 1;
}
.hero-gift {
  font-size: 184rpx;
  line-height: 1;
  animation: bob 2.4s ease-in-out infinite;
}
.logo {
  /* 7 块字牌(86rpx) + 6 个间距(12rpx) = 674rpx，须小于 page 可用宽 750-64=686rpx，末字才不换行 */
  display: flex;
  flex-wrap: nowrap;
  justify-content: center;
  gap: 12rpx;
  margin: 52rpx 0 28rpx;
}
.logo-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 94rpx;
  font-size: 48rpx;
  font-weight: 900;
  background: #fffdf5;
  border: 6rpx solid #33241a;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 0 #33241a;
  animation: bob 2.2s ease-in-out infinite;
}
.logo-chip.c0 {
  background: #ffd45e;
}
.logo-chip.c1 {
  background: #ff9ecf;
}
.logo-chip.c2 {
  background: #52cf9f;
}
.logo-chip.c3 {
  background: #aee3ff;
}
.logo-chip.c4 {
  background: #9b8cff;
  color: #fff;
}
.tagline {
  font-size: 30rpx;
  font-weight: 700;
  opacity: 0.8;
}

.btn-start {
  display: block;
  width: 460rpx;
  margin: 80rpx auto 0;
  padding: 36rpx 0;
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  color: #fff;
  background: linear-gradient(180deg, #ff8a3d, #e86f1f);
  border: 6rpx solid #33241a;
  border-radius: 999rpx;
  box-shadow: 0 14rpx 0 #33241a;
  text-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.15);
  animation: throb 1.8s ease-in-out infinite;
  position: relative;
  z-index: 1;
}
.btn-start.pressed {
  transform: translateY(14rpx);
  box-shadow: 0 0 0 #33241a;
  animation: none;
}
.note {
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  opacity: 0.75;
  margin-top: 36rpx;
  position: relative;
  z-index: 1;
}
.footer {
  text-align: center;
  font-size: 22rpx;
  opacity: 0.55;
  /* auto 外边距把 footer 推到底部；padding-top 保证内容多时仍有间距 */
  margin-top: auto;
  padding-top: 40rpx;
  position: relative;
  z-index: 1;
}

/* ---------- 动画 ---------- */
@keyframes bob {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-14rpx);
  }
}
@keyframes floaty {
  0%,
  100% {
    transform: translateX(0);
  }
  50% {
    transform: translateX(32rpx);
  }
}
@keyframes twinkle {
  0%,
  100% {
    opacity: 0.25;
    transform: scale(0.85);
  }
  50% {
    opacity: 1;
    transform: scale(1.1);
  }
}
@keyframes throb {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.045);
  }
}
